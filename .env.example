# FlareSolverr & Proxy Configuration
FLARESOLVERR_URL=http://localhost:8193
FLARESOLVERR_MAX_TIMEOUT=60000
PROXY_FILE=proxies.txt
OUTPUT_DIR=artifacts
CONCURRENCY=4
MAX_RETRIES=3
LOG_LEVEL=INFO

# Scaling, Crawling & Frontier Queue
MAX_PAGES=1000
MAX_DEPTH=5
CHUNK_SIZE=15
USE_SITEMAP=true
FAST_HTTP_FIRST=true
ENABLE_COMPETITOR=true
REDIS_URL=
SQLITE_DB_NAME=crawl_results.db

# Export & Archiving Settings (EXPORT_FORMAT: json, yaml, csv, or xlsx/excel)
EXPORT_FORMAT=json
EXPORT_MODE=single
EXPORT_CHUNK_SIZE=250
ARCHIVE_FORMAT=none
TAR_COMPRESSION=gz

# SEO Audit & Duplication Thresholds
SEO_TITLE_MIN_LEN=30
SEO_TITLE_MAX_LEN=60
SEO_DESC_MIN_LEN=120
SEO_DESC_MAX_LEN=160
SEO_MIN_WORD_COUNT=300
SEO_DUP_THRESHOLD=0.85
SEO_SLOW_WARN_MS=1000
SEO_SLOW_ERR_MS=3000
SEO_LARGE_WARN_BYTES=1048576
SEO_LARGE_ERR_BYTES=3145728
